---
// Every credential, with the real document behind it. Content lives in src/content/credentials.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DocFrame from '../components/DocFrame.astro';
import DocPreview from '../components/DocPreview.astro';
import Icon from '../components/Icon.astro';
import NameNote from '../components/NameNote.astro';
import Cta from '../components/Cta.astro';
import { documents } from '../data/docs';

const all = (await getCollection('credentials')).sort((a, b) => a.data.order - b.data.order);
const framed = all.filter((c) => c.data.image);
const siteimprove = all.find(
  (c) => c.data.kind === 'certification' && c.data.courses.length === 0 && c.data.doc,
);
const meta = all.find((c) => c.data.courses.length > 0);
const smaller = all.filter(
  (c) => c.data.kind === 'recognition' || (c.data.kind === 'milestone' && !c.data.image),
);
const references = all.filter((c) => c.data.kind === 'reference');
const kindLabel = {
  degree: 'Degree',
  milestone: 'Milestone',
  certification: 'Certification',
  recognition: 'Recognition',
  reference: 'Reference',
};
---

<Base
  title="Credentials"
  description="Minh Tran's degree, Iron Ring, Siteimprove top 5% certificate, Meta Front-End Developer certificate and written references, each with the source document."
>
  <div class="pg">
    <header class="intro anim-title">
      <h1 class="h1">Credentials</h1>
      <p class="lead">
        Each one comes with the document behind it. Select any document to read it here, without leaving the
        page.
      </p>
    </header>

    <section class="framed" aria-label="Degree and Iron Ring">
      {framed.map((c, i) => (
        <article class="cred reveal" id={c.id}>
          <DocFrame
            src={c.data.image!}
            alt={c.data.imageAlt ?? c.data.title}
            caption={c.data.issuer}
            readerCaption={c.data.readerCaption ?? c.data.title}
            label={`Read: ${c.data.title}`}
            tone={i === 0 ? 'slab' : 'accent'}
          />
          <div class="cred__text">
            <p class="cred__kind">
              {kindLabel[c.data.kind]}, {c.data.date}
            </p>
            <h2 class="cred__title">{c.data.title}</h2>
            <p class="cred__sum">{c.data.summary}</p>
            {c.data.doc && (
              <a
                class="cred__pdf"
                href={documents[c.data.doc].pdf}
                data-doc-pdf={documents[c.data.doc].pdf}
                data-doc-caption={c.data.readerCaption ?? c.data.title}
              >
                <Icon name="file-pdf" size={18} /> Open the official PDF
              </a>
            )}
          </div>
        </article>
      ))}
    </section>

    {siteimprove && (
      <section class="sec sec--tight split reveal" id={siteimprove.id}>
        <div>
          <p class="cred__kind">
            {kindLabel[siteimprove.data.kind]}, {siteimprove.data.date}
          </p>
          <h2 class="h2">{siteimprove.data.title}</h2>
          <p class="lead">{siteimprove.data.summary}</p>
        </div>
        {siteimprove.data.doc && <DocPreview doc={siteimprove.data.doc} />}
      </section>
    )}

    {meta && (
      <section class="sec meta" id={meta.id} aria-labelledby="meta-title">
        <div class="meta__head">
          <div>
            <p class="cred__kind">
              {kindLabel[meta.data.kind]}, {meta.data.date}
            </p>
            <div class="anim-title">
              <h2 class="h2" id="meta-title">
                {meta.data.title}
              </h2>
            </div>
            <p class="lead">{meta.data.summary}</p>
          </div>
          <p class="meta__count" aria-hidden="true">
            <span>{meta.data.courses.length}</span> courses
          </p>
        </div>
        {meta.data.doc && (
          <div class="meta__cert">
            <DocPreview doc={meta.data.doc} />
          </div>
        )}
        <ol class="courses" data-observe>
          {meta.data.courses.map((k, i) => (
            <li class="course" style={`--i:${i}`}>
              <span class="course__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="course__title">{k.title}</h3>
              <p class="course__used">
                <Icon name="arrow-elbow-down-right" size={16} />
                <span>{k.used}</span>
              </p>
            </li>
          ))}
        </ol>
        <p class="meta__outcome">
          <Icon name="briefcase" size={20} />
          <span>
            <b>Where it led.</b> These courses were my preparation for the co-op search, and they are the
            HTML, CSS, JavaScript and UX foundation I used every day at the City of Brampton.
          </span>
        </p>
        {meta.data.link && (
          <Cta href={meta.data.link.href} variant="ghost" external>
            {meta.data.link.label}
          </Cta>
        )}
      </section>
    )}

    <section class="sec sec--tight smaller" aria-label="Academic recognition and next step">
      {smaller.map((c) => (
        <article class="mini reveal" id={c.id}>
          <span class="mini__icon">
            <Icon name={c.data.kind === 'recognition' ? 'medal' : 'seal-check'} size={28} />
          </span>
          <div>
            <p class="cred__kind">
              {kindLabel[c.data.kind]}, {c.data.date}
            </p>
            <h2 class="mini__title">{c.data.title}</h2>
            <p class="cred__sum">
              {c.data.issuer}. {c.data.summary}
            </p>
          </div>
        </article>
      ))}
    </section>

    <section class="sec" id="references" aria-labelledby="ref-title">
      <div class="anim-title">
        <h2 class="h2" id="ref-title">
          References
        </h2>
      </div>
      <p class="lead muted">What the people I worked for and studied with wrote, in full.</p>
      <NameNote />
      <ul class="refs">
        {references.map((c) => (
          <li class="ref reveal" id={c.id}>
            <p class="cred__kind">
              {c.data.issuer}, {c.data.date}
            </p>
            <p class="ref__sum">{c.data.summary}</p>
            {c.data.doc && <DocPreview doc={c.data.doc} />}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .intro {
    padding: var(--space-6) 0 var(--space-5);
    max-width: 60ch;
  }
  .intro .lead {
    margin-top: var(--space-3);
  }
  .cred__pdf {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: var(--space-2);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .cred__pdf:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .meta__cert {
    max-width: 640px;
    margin-top: var(--space-4);
  }
  .cred__kind {
    margin: 0 0 0.4rem;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .cred__title {
    margin: 0;
    font: 700 clamp(24px, 2.4vw, 32px)/1.15 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .cred__sum {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
    max-width: 56ch;
  }

  .framed {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .cred {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .split {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-6);
  }
  .split :global(.dp) {
    margin-top: 0;
  }

  .meta {
  }
  .meta__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: end;
  }
  .meta__count {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--muted);
    text-align: right;
  }
  .meta__count span {
    display: block;
    font: 700 clamp(72px, 9vw, 128px)/0.9 var(--font-sans);
    letter-spacing: -0.05em;
    color: var(--accent-ink);
  }
  .courses {
    list-style: none;
    margin: var(--space-4) 0 var(--space-3);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .course {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    transition:
      border-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .course:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  .course__n {
    font: 700 15px/1 var(--font-sans);
    color: var(--accent-ink);
  }
  .course__title {
    margin: 0;
    font: 700 19px/1.25 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .course__used {
    display: flex;
    gap: 0.45rem;
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
  }
  .course__used :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--accent-ink);
  }
  :global(.js-anim) .courses .course {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 700ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 280ms;
    transition-delay: calc(var(--i) * 60ms);
  }
  :global(.js-anim) .courses:global(.is-in) .course {
    opacity: 1;
    transform: none;
  }
  .meta__outcome {
    display: flex;
    gap: 0.7rem;
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--slab);
    color: var(--on-slab);
    font-size: 17px;
    line-height: 1.55;
  }
  .meta__outcome :global(svg) {
    flex: none;
    margin-top: 3px;
  }

  .smaller {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    padding-top: var(--space-5);
  }
  .mini {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
  }
  .mini__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-sunken);
    color: var(--accent-ink);
  }
  .mini__title {
    margin: 0;
    font: 700 22px/1.2 var(--font-sans);
    letter-spacing: -0.015em;
  }

  .refs {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .ref {
    display: grid;
    align-content: start;
  }
  .ref__sum {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }

  @media (max-width: 1023px) {
    .framed,
    .split,
    .smaller {
      grid-template-columns: 1fr;
    }
    .courses {
      grid-template-columns: 1fr 1fr;
    }
    .refs {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 767px) {
    .refs {
      grid-template-columns: 1fr;
    }
    .courses {
      grid-template-columns: 1fr;
    }
    .meta__head {
      grid-template-columns: 1fr;
    }
    .meta__count {
      text-align: left;
    }
  }
</style>
