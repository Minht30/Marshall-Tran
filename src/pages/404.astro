---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <div class="pg nf">
    <p class="label">404</p>
    <h1 class="h1">This page does not exist.</h1>
    <p class="lead">The link may be old, or the page may have moved when the site was rebuilt.</p>
    <div class="nf__ctas">
      <Cta href="/">Back to the home page</Cta>
      <Cta href="/projects" variant="ghost">
        View case studies
      </Cta>
    </div>
  </div>
</Base>

<style>
  .nf {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
  }
  .nf .h1 {
    margin: var(--space-2) 0 var(--space-3);
    max-width: 14ch;
  }
  .nf__ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
