---
// One reader dialog for the whole site. It shows document images (degree, obligation) and PDFs (feedback, certificates).
import Icon from './Icon.astro';
---

<dialog class="reader" id="doc-reader" aria-label="Document">
  <div class="reader__stage">
    <img id="doc-reader-img" src="" alt="" hidden />
    <iframe id="doc-reader-pdf" title="Document preview" hidden></iframe>
  </div>
  <div class="reader__bar">
    <span id="doc-reader-cap"></span>
    <span class="reader__actions">
      <a class="reader__btn" id="doc-reader-open" href="#" target="_blank" rel="noopener" hidden>
        <Icon name="arrow-square-out" size={16} /> Open
      </a>
      <a class="reader__btn" id="doc-reader-dl" href="#" download hidden>
        <Icon name="download-simple" size={16} /> Download
      </a>
      <button type="button" class="reader__btn" id="doc-reader-close">
        <Icon name="x" size={16} /> Close
      </button>
    </span>
  </div>
</dialog>

<script>
  // Bound once; elements are looked up at click time because the router swaps the page.
  let opener: HTMLElement | null = null;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const dlg = $<HTMLDialogElement>('doc-reader');
    if (!dlg) return;
    const btn = target.closest<HTMLElement>('[data-doc-full], [data-doc-pdf]');
    if (btn) {
      e.preventDefault();
      opener = btn;
      const img = $<HTMLImageElement>('doc-reader-img');
      const pdf = $<HTMLIFrameElement>('doc-reader-pdf');
      const isPdf = !!btn.dataset.docPdf;
      img.hidden = isPdf;
      pdf.hidden = !isPdf;
      $('doc-reader-open').hidden = !isPdf;
      $('doc-reader-dl').hidden = !isPdf;
      if (isPdf) {
        pdf.src = `${btn.dataset.docPdf}#view=FitH`;
        ($('doc-reader-open') as HTMLAnchorElement).href = btn.dataset.docPdf!;
        ($('doc-reader-dl') as HTMLAnchorElement).href = btn.dataset.docPdf!;
      } else {
        img.src = btn.dataset.docFull ?? '';
        img.alt = btn.dataset.docAlt ?? '';
      }
      $('doc-reader-cap').textContent = btn.dataset.docCaption ?? '';
      dlg.showModal();
      $('doc-reader-close').focus();
      return;
    }
    if (target.closest('#doc-reader-close') || target === dlg) dlg.close();
  });
  document.addEventListener(
    'close',
    (e) => {
      if ((e.target as HTMLElement).id !== 'doc-reader') return;
      const pdf = document.getElementById('doc-reader-pdf') as HTMLIFrameElement | null;
      if (pdf && !pdf.hidden) pdf.src = 'about:blank';
      opener?.focus();
    },
    true,
  );
</script>

<style>
  .reader {
    border: 0;
    padding: 0;
    background: transparent;
    width: min(1200px, 94vw);
    max-width: none;
    max-height: 94dvh;
    overflow: visible;
  }
  .reader::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(4px);
  }
  .reader__stage {
    display: grid;
    place-items: center;
  }
  .reader img {
    display: block;
    max-width: 100%;
    max-height: 84dvh;
    width: auto;
    margin: 0 auto;
    box-shadow: var(--shadow-md);
    background: #fbfcfd;
  }
  .reader iframe {
    width: min(900px, 94vw);
    height: 82dvh;
    border: 0;
    border-radius: var(--radius-md);
    background: #fbfcfd;
    box-shadow: var(--shadow-md);
  }
  .reader [hidden] {
    display: none;
  }
  .reader__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) auto 0;
    max-width: 900px;
    color: var(--mist);
    font-size: 14px;
  }
  .reader__actions {
    display: flex;
    gap: var(--space-1);
  }
  .reader__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 40px;
    padding: 0 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--mist);
    background: transparent;
    color: var(--mist);
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
  }
  .reader__btn:hover {
    background: color-mix(in srgb, var(--mist) 12%, transparent);
  }
</style>
