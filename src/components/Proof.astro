---
// Points a quote or claim at its source document. With a doc key it shows a real first-page preview.
import DocPreview from './DocPreview.astro';
import { docKeyFor, type DocKey } from '../data/docs';

interface Props {
  href?: string;
  doc?: DocKey;
  small?: boolean;
}
const { href, small = false } = Astro.props;
const doc = Astro.props.doc ?? (href ? docKeyFor(href) : undefined);
---

{doc ? (
  <DocPreview doc={doc} size={small ? 'compact' : 'page'} />
) : (
  <a
    class:list={['proof', { 'proof--small': small }]}
    href={href}
    data-doc-pdf={href}
    target="_blank"
    rel="noopener"
  >
    <slot />
    <span class="proof__icon" aria-hidden="true">
      PDF
    </span>
    <span class="sr-only"> (PDF preview)</span>
  </a>
)}

<style>
  .proof {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-2);
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    text-decoration: none;
    font-size: 14px;
    transition:
      border-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 180ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .proof:hover {
    border-color: var(--accent);
  }
  .proof:active {
    transform: scale(0.98);
  }
  .proof__icon {
    display: inline-grid;
    place-items: center;
    height: 28px;
    padding: 0 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    color: var(--accent-ink);
    font: 600 12px/1 var(--font-sans);
  }
  .proof--small {
    margin-top: 0.6rem;
    font-size: 14px;
  }
</style>
