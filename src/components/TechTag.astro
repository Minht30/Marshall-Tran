---
// A technology tag with its real colour logo, used everywhere a tool is named so they all look the same.
// Every logo sits on the same small white tile, so dark logos stay visible in the dark theme
// and every tag lines up whatever the logo's shape.
import Icon from './Icon.astro';
import { tech } from '../data/tech';

const logos = import.meta.glob('/src/icons/color/*.svg', {
  query: '?url',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  accent?: boolean;
}
const { name, size = 'sm', accent = false } = Astro.props;
const entry = tech[name];
const logo = entry?.logo ? logos[`/src/icons/color/${entry.logo}.svg`] : undefined;
const px = size === 'lg' ? 30 : size === 'md' ? 18 : 15;
---

<span class:list={['tt', `tt--${size}`, { 'tt--accent': accent }]}>
  {(logo || entry?.icon) && (
    <span class:list={['tt__tile', { 'tt__tile--icon': !logo }]} aria-hidden="true">
      {logo ? (
        <img src={logo} alt="" width={px} height={px} loading="lazy" decoding="async" />
      ) : (
        <Icon name={entry!.icon!} size={px} />
      )}
    </span>
  )}
  <span class="tt__name">{name}</span>
</span>

<style>
  .tt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 34px;
    padding: 0 0.8rem 0 0.25rem;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    border: 1px solid var(--rule);
    color: var(--ink);
    font: 500 14px/1 var(--font-sans);
    white-space: nowrap;
    transition:
      border-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .tt:not(:has(.tt__tile)) {
    padding-left: 0.8rem;
  }
  .tt__tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(10 25 60 / 0.08);
  }
  .tt__tile img {
    display: block;
    object-fit: contain;
  }
  .tt__tile--icon {
    background: var(--action);
    color: var(--on-action);
    box-shadow: none;
  }
  .tt--accent {
    border-color: var(--accent);
  }
  .tt--md {
    height: 40px;
    padding-right: 1rem;
    font-size: 15px;
  }
  .tt--md .tt__tile {
    width: 32px;
    height: 32px;
  }

  /* lg: a logo tile above the name, used for the headline skills. */
  .tt--lg {
    height: auto;
    padding: 0;
    background: none;
    border: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 18px;
    font-weight: 700;
  }
  .tt--lg .tt__tile {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    box-shadow:
      inset 0 0 0 1px rgb(10 25 60 / 0.08),
      0 8px 20px -10px rgb(10 25 60 / 0.4);
  }
  .tt--lg .tt__tile--icon {
    box-shadow: 0 8px 20px -10px rgb(10 25 60 / 0.4);
  }
</style>
