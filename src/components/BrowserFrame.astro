---
// A real screenshot in a double-bezel browser window, with an optional caption.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  url?: string;
  caption?: string;
  height?: number;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
}
const {
  src,
  alt,
  url,
  caption,
  height,
  widths = [640, 960, 1280, 1600],
  sizes = '(min-width: 1240px) 1180px, 100vw',
  priority = false,
} = Astro.props;
---

<figure class="bf">
  <div class="tray">
    <div class="win">
      {url && (
        <div class="win__bar">
          <span class="win__url">{url}</span>
        </div>
      )}
      <div class="bf__view" style={height ? `height:${height}px` : undefined}>
        <Image
          src={src}
          alt={alt}
          widths={widths}
          width={Math.min(src.width, Math.max(...widths))}
          sizes={sizes}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </div>
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .bf {
    margin: 0;
  }
  .bf__view {
    overflow: hidden;
    background: var(--surface-sunken);
  }
  .bf__view :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 14px;
    color: var(--muted);
  }
</style>
