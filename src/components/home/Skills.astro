---
// Skills: the five I use every day, then the full set by area, AI tools, and spoken languages.
import TechTag from '../TechTag.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

const daily = [
  { name: 'SharePoint', proof: '1,500+ City pages built and maintained' },
  { name: 'JavaScript', proof: 'Waste sorter search, SharePoint page logic' },
  { name: 'React', proof: 'Cat Tracker app, TTC transit tracker' },
  { name: 'CSS', proof: 'Responsive layouts for GrowGreen and BEMO' },
  { name: 'WCAG', proof: 'AODA and WCAG 2.1 audits, top 5% Siteimprove' },
];
const groups = [
  {
    icon: 'browser',
    title: 'Front end',
    items: [
      'React',
      'JavaScript',
      'TypeScript',
      'HTML',
      'CSS',
      'Next.js',
      'Tailwind CSS',
      'Bootstrap',
      'jQuery',
    ],
  },
  {
    icon: 'database',
    title: 'Back end and data',
    items: ['Python', 'REST APIs', 'SQL', 'MySQL', 'Firebase', 'Supabase', 'FastAPI'],
  },
  {
    icon: 'paint-brush',
    title: 'Design, CMS and accessibility',
    items: ['Figma', 'Adobe XD', 'SharePoint Online', 'WordPress', 'Wix Studio', 'WCAG 2.1', 'Siteimprove'],
  },
  {
    icon: 'check-circle',
    title: 'QA, testing and DevOps',
    items: ['JUnit', 'Docker', 'Git', 'GitHub Actions', 'Jira', 'Vercel'],
  },
];
const ai = {
  main: [
    {
      name: 'Claude',
      use: 'My main coding assistant. I used it to build FindYourself, from the spec to the tests.',
    },
    { name: 'Ollama', use: 'Local LLMs for AI-assisted test generation in the TASKANA testing project.' },
  ],
  also: ['ChatGPT', 'GitHub Copilot', 'Prompt engineering', 'OpenCV', 'YOLO11'],
};
const levelDots = { Native: 4, Fluent: 4, Elementary: 1 } as Record<string, number>;
---

<section class="sk" id="skills" aria-labelledby="sk-title">
  <div class="sk__head">
    <h2 class="h2" id="sk-title">
      Skills
    </h2>
    <p class="lead muted">The five I use every day, then everything else I work with.</p>
  </div>

  <ul class="daily" data-observe>
    {daily.map((s, i) => (
      <li class="daily__item" style={`--i:${i}`}>
        <TechTag name={s.name} size="lg" />
        <p>{s.proof}</p>
      </li>
    ))}
  </ul>

  <div class="sets">
    {groups.map((g) => (
      <section class="set reveal" aria-label={g.title}>
        <h3 class="set__title">
          <Icon name={g.icon} size={20} />
          {g.title}
        </h3>
        <div class="set__tags">
          {g.items.map((t) => (
            <TechTag name={t} />
          ))}
        </div>
      </section>
    ))}

    <section class="set set--ai reveal" aria-label="AI tools">
      <h3 class="set__title">
        <Icon name="sparkle" size={20} />
        AI tools
      </h3>
      <ul class="ai">
        {ai.main.map((a) => (
          <li>
            <TechTag name={a.name} size="md" accent />
            <p>{a.use}</p>
          </li>
        ))}
      </ul>
      <div class="set__tags">
        {ai.also.map((t) => (
          <TechTag name={t} />
        ))}
      </div>
    </section>

    <section class="set reveal" aria-label="Languages">
      <h3 class="set__title">
        <Icon name="translate" size={20} />
        Languages
      </h3>
      <ul class="langs">
        {site.languages.map((l) => (
          <li>
            <span class="langs__name">{l.name}</span>
            <span class="langs__level">
              <span class="dots" aria-hidden="true">
                {[1, 2, 3, 4].map((n) => (
                  <i class:list={{ on: n <= (levelDots[l.level] ?? 2) }} />
                ))}
              </span>
              {l.level}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  .sk {
    padding-bottom: var(--space-6);
  }
  .sk__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  .sk__head .lead {
    margin: 0;
  }
  .daily {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-2);
  }
  .daily__item {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    transition:
      border-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .daily__item:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }
  .daily__item p {
    margin: var(--space-2) 0 0;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.5;
  }
  :global(.js-anim) .daily .daily__item {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 700ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 280ms;
    transition-delay: calc(var(--i) * 90ms);
  }
  :global(.js-anim) .daily:global(.is-in) .daily__item {
    opacity: 1;
    transform: none;
  }

  .sets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .set {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
  }
  .set__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 var(--space-2);
    font: 700 17px/1.2 var(--font-sans);
  }
  .set__title :global(svg) {
    color: var(--accent-ink);
  }
  .set__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .set--ai {
    grid-column: span 3;
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--mark-bg), transparent 60%), var(--surface-raised);
  }
  .ai {
    list-style: none;
    margin: 0 0 var(--space-2);
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }
  .ai p {
    margin: 0.5rem 0 0;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.5;
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--rule);
  }
  .langs li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .langs__name {
    font-weight: 600;
  }
  .langs__level {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 14px;
    color: var(--muted);
  }
  .dots {
    display: inline-flex;
    gap: 3px;
  }
  .dots i {
    width: 14px;
    height: 6px;
    border-radius: 3px;
    background: var(--rule);
  }
  .dots i.on {
    background: var(--accent);
  }

  @media (max-width: 1023px) {
    .daily {
      grid-template-columns: repeat(3, 1fr);
    }
    .sets {
      grid-template-columns: 1fr 1fr;
    }
    .set--ai {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .daily {
      grid-template-columns: 1fr 1fr;
    }
    .sets,
    .ai {
      grid-template-columns: 1fr;
    }
    .set--ai {
      grid-column: auto;
    }
  }
</style>
