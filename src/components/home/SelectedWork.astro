---
// Full-width case-study cards, alternating image left and right. Order comes from src/content/work.
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import TechTag from '../TechTag.astro';
import Zoomable from '../Zoomable.astro';
import Status from '../Status.astro';
import ProjectLinks from '../ProjectLinks.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section class="sec wk" id="featured" aria-labelledby="work-title">
  <div class="pg">
    <div class="anim-title">
      <h2 class="h2" id="work-title">
        Featured projects
      </h2>
    </div>
    <p class="lead muted">Four projects, each with what it is, what I did, and the numbers behind it.</p>

    <div class="wk__list">
      {work.map((w, i) => (
        <article class:list={['card', { 'card--flip': i % 2 === 1 }]} data-observe>
          <div class="card__media">
            <Zoomable
              src={w.data.cover}
              alt={w.data.coverAlt}
              caption={`${w.data.title}: ${w.data.coverAlt}`}
              widths={[600, 900, 1300]}
              sizes="(min-width: 1024px) 680px, 100vw"
              vt={`cover-${w.id}`}
            />
          </div>
          <div class="card__body">
            <div class="card__top">
              <p class="card__context">{w.data.context}</p>
              <Status status={w.data.status} />
            </div>
            <h3 class="card__title" transition:name={`title-${w.id}`}>
              <a href={`/work/${w.id}`}>{w.data.title}</a>
            </h3>
            <p class="card__sum">{w.data.summary}</p>
            <p class="card__role">
              <Icon name="briefcase" size={18} />
              {w.data.role}
            </p>
            {w.data.metrics.length > 0 && (
              <dl class="card__metrics">
                {w.data.metrics.map((m) => (
                  <div>
                    <dt>{m.value}</dt>
                    <dd>{m.label}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="card__tags">
              {w.data.tags.map((t) => (
                <TechTag name={t} />
              ))}
            </div>
            <div class="card__actions">
              <a class="card__go" href={`/work/${w.id}`}>
                View case study
                <span class="card__dot">
                  <Icon name="arrow-up-right" size={18} />
                </span>
              </a>
              <ProjectLinks links={w.data.links} note={w.data.codeNote} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .wk {
    background: var(--surface-sunken);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .wk__list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .card {
    display: grid;
    grid-template-columns: 7fr 5fr;
    min-height: 520px;
    border-radius: calc(var(--radius-lg) + 8px);
    padding: 8px;
    background: var(--ground);
    border: 1px solid var(--rule);
    color: var(--ink);
    transition:
      border-color 400ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
  .card--flip {
    grid-template-columns: 5fr 7fr;
  }
  .card--flip .card__media {
    order: 2;
  }
  /* The whole image, never cropped, centred on a quiet backdrop. */
  .card__media {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: radial-gradient(closest-side, var(--mark-bg), transparent), var(--surface-sunken);
  }
  .card__media :global(.zoom) {
    width: auto;
    max-width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .card__media :global(.zoom img) {
    width: auto;
    max-width: 100%;
    max-height: 560px;
    margin: 0 auto;
    transition: transform 1200ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .card__media :global(.zoom:hover img) {
    transform: scale(1.03);
  }
  .card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .card__title a {
    color: inherit;
    text-decoration: none;
  }
  .card__title a:hover {
    color: var(--accent-ink);
  }
  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: var(--space-4);
  }
  .card__context {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .card__title {
    margin: 0;
    font: 700 clamp(34px, 3.6vw, 52px)/1.02 var(--font-sans);
    letter-spacing: -0.035em;
  }
  .card__sum {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
  .card__role {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0;
    font-size: 16px;
    font-weight: 500;
  }
  .card__role :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--accent-ink);
  }
  .card__metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    margin: 0.3rem 0 0;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .card__metrics dt {
    font: 700 26px/1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .card__metrics dd {
    margin: 0.35rem 0 0;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.3;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
  }
  .card__dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--action);
    color: var(--on-action);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .card__go:hover .card__dot {
    transform: translate(4px, -3px) scale(1.06);
  }

  /* Each card's image wipes in from its own side as it scrolls into view. */
  :global(.js-anim) .card .card__media {
    clip-path: inset(0 100% 0 0 round var(--radius-lg));
    transition: clip-path 1100ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  :global(.js-anim) .card--flip .card__media {
    clip-path: inset(0 0 0 100% round var(--radius-lg));
  }
  :global(.js-anim) .card:global(.is-in) .card__media {
    clip-path: inset(0 0 0 0 round var(--radius-lg));
  }
  :global(.js-anim) .card .card__body > * {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  :global(.js-anim) .card:global(.is-in) .card__body > * {
    opacity: 1;
    transform: none;
  }
  :global(.js-anim) .card:global(.is-in) .card__body > :nth-child(2) {
    transition-delay: 80ms;
  }
  :global(.js-anim) .card:global(.is-in) .card__body > :nth-child(3) {
    transition-delay: 160ms;
  }
  :global(.js-anim) .card:global(.is-in) .card__body > :nth-child(n + 4) {
    transition-delay: 240ms;
  }

  @media (max-width: 1023px) {
    .card,
    .card--flip {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .card--flip .card__media {
      order: 0;
    }
    .card__media :global(.zoom img) {
      max-height: 460px;
    }
  }
  @media (max-width: 767px) {
    .card__body {
      padding: var(--space-3) var(--space-2);
    }
    .card__metrics dt {
      font-size: 22px;
    }
  }
</style>
