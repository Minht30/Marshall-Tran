---
// Four featured credentials with their real documents; the full set lives on /credentials.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Cta from '../Cta.astro';
import { documents } from '../../data/docs';

const featured = (await getCollection('credentials'))
  .filter((c) => c.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const kindLabel = {
  degree: 'Degree',
  milestone: 'Milestone',
  certification: 'Certification',
  recognition: 'Recognition',
  reference: 'Reference',
};
---

<section class="sec cs" id="credentials" aria-labelledby="cs-title">
  <div class="anim-title">
    <h2 class="h2" id="cs-title">
      Credentials
    </h2>
  </div>
  <ul class="cs__grid" data-observe>
    {featured.map((c, i) => {
      const thumb = c.data.image ?? (c.data.doc ? documents[c.data.doc].page : undefined);
      return (
        <li class="cs__item" style={`--i:${i}`}>
          <a href={`/credentials#${c.id}`} class="cs__link">
            <span class="cs__thumb">
              {thumb ? (
                <Image
                  src={thumb}
                  alt=""
                  widths={[320, 520]}
                  width={520}
                  sizes="(min-width: 1024px) 280px, 50vw"
                />
              ) : (
                <span class="cs__icon">
                  <Icon name="certificate" size={44} />
                  <span>9 courses</span>
                </span>
              )}
            </span>
            <span class="cs__kind">{kindLabel[c.data.kind]}</span>
            <span class="cs__title">{c.data.title}</span>
            <span class="cs__meta">
              {c.data.issuer}, {c.data.date}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
  <Cta href="/credentials" variant="ghost">
    All credentials and references
  </Cta>
</section>

<style>
  .cs__grid {
    list-style: none;
    margin: var(--space-3) 0 var(--space-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .cs__link {
    display: grid;
    gap: 0.45rem;
    color: var(--ink);
    text-decoration: none;
  }
  .cs__thumb {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #fbfcfd;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-sm);
    transition:
      transform 500ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 280ms;
  }
  .cs__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .cs__link:hover .cs__thumb {
    transform: translateY(-6px) rotate(-1deg);
    border-color: var(--accent);
  }
  .cs__icon {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.5rem;
    height: 100%;
    background: var(--slab);
    color: var(--on-slab);
    font-weight: 600;
  }
  .cs__kind {
    margin-top: 0.5rem;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .cs__title {
    font: 700 19px/1.25 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .cs__meta {
    font-size: 14px;
    color: var(--muted);
  }
  :global(.js-anim) .cs__grid .cs__item {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
    transition-delay: calc(var(--i) * 100ms);
  }
  :global(.js-anim) .cs__grid:global(.is-in) .cs__item {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 1023px) {
    .cs__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .cs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
