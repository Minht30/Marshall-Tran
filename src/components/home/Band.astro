---
// A large clickable band: a fan of photos on one side, a short pitch and a button on the other.
// Used for "Explore my projects" and "Read my story" on the home page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  href: string;
  kicker: string;
  title: string;
  body?: string;
  cta: string;
  images: ImageMetadata[];
  stats?: { value: string; label: string }[];
  /** Put the photos on the left instead of the right. */
  flip?: boolean;
  id?: string;
}
const { href, kicker, title, body, cta, images, stats = [], flip = false, id } = Astro.props;
---

<section class="band-wrap" id={id}>
  <a class:list={['band', { 'band--flip': flip }]} href={href}>
    <span class="band__text">
      <span class="band__kicker">{kicker}</span>
      <span class="band__title">{title}</span>
      {body && <span class="band__body">{body}</span>}
      {stats.length > 0 && (
        <span class="band__stats">
          {stats.map((s) => (
            <span class="band__stat">
              <b>{s.value}</b>
              <span>{s.label}</span>
            </span>
          ))}
        </span>
      )}
      <span class="band__go">
        {cta}
        <span class="band__dot">
          <Icon name="arrow-right" size={18} />
        </span>
      </span>
    </span>
    <span class="band__fan" aria-hidden="true">
      {images.slice(0, 4).map((src, i) => (
        <span class="band__card" style={`--i:${i}`}>
          <Image src={src} alt="" widths={[240, 400]} width={400} sizes="220px" />
        </span>
      ))}
    </span>
  </a>
</section>

<style>
  .band-wrap {
    padding: var(--space-6) 0;
  }
  .band {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border-radius: calc(var(--radius-lg) + 4px);
    background: var(--slab);
    color: var(--on-slab);
    text-decoration: none;
    overflow: hidden;
    transition: transform 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .band:hover {
    transform: translateY(-3px);
  }
  .band--flip .band__fan {
    order: -1;
  }
  .band__text {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .band__kicker {
    font-size: 15px;
    font-weight: 600;
    opacity: 0.8;
  }
  .band__title {
    font: 700 clamp(28px, 3.2vw, 44px)/1.08 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .band__body {
    max-width: 48ch;
    font-size: 17px;
    line-height: 1.6;
    opacity: 0.9;
  }
  .band__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: 0.3rem;
  }
  .band__stat {
    display: grid;
  }
  .band__stat b {
    font: 700 30px/1 var(--font-sans);
    letter-spacing: -0.03em;
  }
  .band__stat span {
    margin-top: 0.3rem;
    font-size: 14px;
    opacity: 0.8;
  }
  .band__go {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: var(--space-1);
    font-weight: 700;
  }
  .band__dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--on-slab);
    color: var(--slab);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .band:hover .band__dot {
    transform: translateX(6px);
  }
  .band__fan {
    position: relative;
    height: 280px;
  }
  .band__card {
    position: absolute;
    top: 50%;
    left: calc(var(--i) * 20%);
    width: 38%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #fff;
    border: 3px solid var(--on-slab);
    box-shadow: var(--shadow-md);
    transform: translateY(-50%) rotate(calc((var(--i) - 1.5) * 5deg));
    transition: transform 600ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .band__card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .band:hover .band__card {
    transform: translateY(-56%) rotate(calc((var(--i) - 1.5) * 9deg))
      translateX(calc((var(--i) - 1.5) * 14px));
  }
  @media (max-width: 1023px) {
    .band {
      grid-template-columns: 1fr;
      padding: var(--space-4);
    }
    .band--flip .band__fan {
      order: 0;
    }
  }
  @media (max-width: 767px) {
    .band__fan {
      height: 200px;
    }
  }
</style>
