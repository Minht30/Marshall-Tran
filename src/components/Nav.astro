---
// A floating pill navigation: monogram and name, the page links, a Resume button and a day/night switch.
import Icon from './Icon.astro';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) =>
  (href === '/story' && path === '/story') ||
  (href === '/credentials' && path === '/credentials') ||
  (href === '/projects' && (path.startsWith('/projects') || path.startsWith('/work')));
---

<header class="nav">
  <nav class="nav__pill" aria-label="Main">
    <a class="nav__brand" href="/">
      <span class="nav__mono" aria-hidden="true">
        MT
      </span>
      <span class="nav__name">{site.shortName}</span>
    </a>
    <ul class="nav__links" id="nav-links">
      {site.nav.map((l) => (
        <li>
          <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="nav__tools">
      <a class="nav__resume" href={site.resume} target="_blank" rel="noopener">
        <span class="nav__resume-text">Resume</span>
        <span class="nav__resume-icon" aria-hidden="true">
          <Icon name="download-simple" size={16} />
        </span>
      </a>
      <button
        class="switch"
        id="theme-toggle"
        type="button"
        role="switch"
        aria-checked="true"
        aria-label="Night theme"
      >
        <span class="switch__track" aria-hidden="true">
          <span class="switch__icon switch__icon--sun">
            <Icon name="sun" size={15} />
          </span>
          <span class="switch__icon switch__icon--moon">
            <Icon name="moon" size={15} />
          </span>
          <span class="switch__knob"></span>
        </span>
      </button>
      <button
        class="nav__menu"
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label="Open menu"
      >
        <span class="bars" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    padding: 10px var(--space-3) 0;
    pointer-events: none;
  }
  .nav__pill {
    pointer-events: auto;
    max-width: calc(var(--container) + 32px);
    margin: 0 auto;
    height: 58px;
    padding: 0 8px 0 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface-raised) 78%, transparent);
    border: 1px solid var(--rule-strong);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 14px 40px -18px rgb(0 0 0 / 0.55);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .nav__mono {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: #061334;
    font: 800 15px/1 var(--font-sans);
    letter-spacing: -0.02em;
    box-shadow: 0 6px 16px -8px var(--accent);
  }
  .nav__name {
    font: 700 17px/1 var(--font-sans);
    letter-spacing: -0.01em;
  }
  .nav__links {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    display: block;
    padding: 0.6rem 0.95rem;
    border-radius: var(--radius-pill);
    color: var(--ink);
    opacity: 0.82;
    text-decoration: none;
    font: 600 15px/1 var(--font-sans);
    transition:
      background-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 280ms,
      color 280ms;
  }
  .nav__links a:hover {
    opacity: 1;
    background: var(--mark-bg);
  }
  .nav__links a[aria-current='page'] {
    opacity: 1;
    background: var(--action);
    color: var(--on-action);
  }
  .nav__tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* Resume: the one bright, glowing call to action in the bar, with a slow light sweep. */
  .nav__resume {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 44px;
    padding: 0 5px 0 1.15rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(120deg, #6fe3ea, var(--accent) 45%, #2aa3c4);
    color: #061334;
    font: 800 15px/1 var(--font-sans);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.25) inset,
      0 8px 24px -8px color-mix(in srgb, var(--accent) 80%, transparent),
      0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
    transition:
      transform 220ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 280ms;
  }
  .nav__resume::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.55) 50%, transparent 70%);
    transform: translateX(-120%);
    animation: sweep 4.5s cubic-bezier(0.32, 0.72, 0, 1) 1.5s infinite;
  }
  @keyframes sweep {
    0%,
    60% {
      transform: translateX(-120%);
    }
    100% {
      transform: translateX(120%);
    }
  }
  .nav__resume-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #061334;
    color: #6fe3ea;
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .nav__resume:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.3) inset,
      0 12px 30px -8px color-mix(in srgb, var(--accent) 95%, transparent),
      0 0 0 6px color-mix(in srgb, var(--accent) 24%, transparent);
  }
  .nav__resume:hover .nav__resume-icon {
    transform: translateY(2px);
  }
  .nav__resume:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__resume::after {
      animation: none;
    }
  }

  /* Day/night switch: sun on the left, moon on the right, the knob slides to the active one. */
  .switch {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: var(--radius-pill);
  }
  .switch__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 72px;
    height: 38px;
    padding: 0 9px;
    border-radius: var(--radius-pill);
    background: var(--surface-sunken);
    border: 1px solid var(--rule-strong);
  }
  .switch__icon {
    position: relative;
    z-index: 1;
    display: grid;
    color: var(--muted);
    transition: color 300ms;
  }
  .switch__knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.5);
    transform: translateX(34px);
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .switch[aria-checked='true'] .switch__icon--moon,
  .switch[aria-checked='false'] .switch__icon--sun {
    color: #061334;
  }
  .switch[aria-checked='false'] .switch__knob {
    transform: translateX(0);
    background: #f5b52e;
  }

  .nav__menu {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink);
    place-items: center;
    cursor: pointer;
  }
  .bars {
    position: relative;
    width: 16px;
    height: 10px;
  }
  .bars i {
    position: absolute;
    left: 0;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
      top 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .bars i:first-child {
    top: 1px;
  }
  .bars i:last-child {
    top: 7px;
  }
  .nav__menu[aria-expanded='true'] .bars i:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .nav__menu[aria-expanded='true'] .bars i:last-child {
    top: 4px;
    transform: rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .nav {
      padding: 8px var(--space-2) 0;
    }
    .nav__menu {
      display: inline-grid;
    }
    .nav__links {
      position: fixed;
      inset: 0;
      z-index: -1;
      flex-direction: column;
      justify-content: center;
      gap: 0.3rem;
      padding: var(--space-6) var(--space-4);
      background: color-mix(in srgb, var(--ground) 94%, transparent);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 400ms cubic-bezier(0.32, 0.72, 0, 1),
        visibility 0s linear 400ms;
    }
    .nav__links a {
      font: 700 34px/1.2 var(--font-sans);
      letter-spacing: -0.02em;
      padding: 0.5rem 1rem;
    }
    .nav__links li {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 500ms cubic-bezier(0.32, 0.72, 0, 1),
        transform 500ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    .nav.is-open .nav__links {
      visibility: visible;
      opacity: 1;
      transition-delay: 0s;
    }
    .nav.is-open .nav__links li {
      opacity: 1;
      transform: none;
    }
    .nav.is-open .nav__links li:nth-child(2) {
      transition-delay: 50ms;
    }
    .nav.is-open .nav__links li:nth-child(3) {
      transition-delay: 100ms;
    }
    .nav.is-open .nav__links li:nth-child(4) {
      transition-delay: 150ms;
    }
    .nav.is-open .nav__links li:nth-child(5) {
      transition-delay: 200ms;
    }
    .nav.is-open .nav__links li:nth-child(6) {
      transition-delay: 250ms;
    }
  }
  @media (max-width: 520px) {
    .nav__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .nav__resume {
      padding-left: 0.85rem;
    }
  }
</style>
