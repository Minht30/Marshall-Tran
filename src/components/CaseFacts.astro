---
// The recruiter's summary at the top of every case study: same fields, same order, on every project.
import Icon from './Icon.astro';
import TechTag from './TechTag.astro';

interface Props {
  objective: string;
  role: string;
  duration: string;
  team: string;
  tech: string[];
  results: { value: string; label: string }[];
  live?: { label: string; href: string };
}
const { objective, role, duration, team, tech, results, live } = Astro.props;
---

<section class="cf reveal" aria-label="Project summary">
  <dl class="cf__facts">
    <div class="cf__wide">
      <dt>
        <Icon name="target" size={18} />
        Objective
      </dt>
      <dd>{objective}</dd>
    </div>
    <div>
      <dt>
        <Icon name="user" size={18} />
        My role
      </dt>
      <dd>{role}</dd>
    </div>
    <div>
      <dt>
        <Icon name="calendar-blank" size={18} />
        Duration
      </dt>
      <dd>{duration}</dd>
    </div>
    <div>
      <dt>
        <Icon name="users-three" size={18} />
        Team
      </dt>
      <dd>{team}</dd>
    </div>
    <div class="cf__wide">
      <dt>
        <Icon name="stack" size={18} />
        Technologies
      </dt>
      <dd class="cf__tech">
        {tech.map((t) => (
          <TechTag name={t} size="md" />
        ))}
      </dd>
    </div>
  </dl>
  <div class="cf__side">
    <p class="cf__head">
      <Icon name="chart-line-up" size={18} />
      Results
    </p>
    <dl class="cf__results" data-observe>
      {results.map((r) => (
        <div>
          <dt>{r.value}</dt>
          <dd>{r.label}</dd>
        </div>
      ))}
    </dl>
    {live && (
      <a class="cf__live" href={live.href} target="_blank" rel="noopener">
        <span>{live.label}</span>
        <span class="cf__dot">
          <Icon name="arrow-up-right" size={18} />
        </span>
      </a>
    )}
  </div>
</section>

<style>
  .cf {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 8px;
    border-radius: calc(var(--radius-lg) + 8px);
    background: var(--surface-sunken);
    border: 1px solid var(--rule);
  }
  .cf__facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
  }
  .cf__wide {
    grid-column: 1 / -1;
  }
  .cf dt,
  .cf__head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .cf__facts dd {
    margin: 0.4rem 0 0;
    font-size: 17px;
    line-height: 1.5;
    max-width: 70ch;
  }
  .cf__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cf__side {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--slab);
    color: var(--on-slab);
  }
  .cf__side .cf__head {
    color: var(--on-slab);
    opacity: 0.85;
  }
  .cf__results {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .cf__results dt {
    display: block;
    font: 700 clamp(34px, 3.4vw, 46px)/1 var(--font-sans);
    letter-spacing: -0.035em;
    color: var(--on-slab);
  }
  .cf__results dd {
    margin: 0.3rem 0 0;
    font-size: 15px;
    opacity: 0.85;
  }
  :global(.js-anim) .cf__results > div {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 700ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  :global(.js-anim) .cf__results > div:nth-child(2) {
    transition-delay: 120ms;
  }
  :global(.js-anim) .cf__results > div:nth-child(3) {
    transition-delay: 240ms;
  }
  :global(.js-anim) .cf__results:global(.is-in) > div {
    opacity: 1;
    transform: none;
  }
  .cf__live {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: auto;
    padding: 0.55rem 0.55rem 0.55rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--on-slab);
    color: var(--slab);
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: transform 180ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cf__live:active {
    transform: scale(0.98);
  }
  .cf__dot {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--slab);
    color: var(--on-slab);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cf__live:hover .cf__dot {
    transform: translate(3px, -2px) scale(1.06);
  }
  @media (max-width: 1023px) {
    .cf {
      grid-template-columns: 1fr;
    }
    .cf__results {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 767px) {
    .cf__facts {
      grid-template-columns: 1fr;
      padding: var(--space-3);
    }
    .cf__side {
      padding: var(--space-3);
    }
    .cf__results {
      grid-template-columns: 1fr;
    }
  }
</style>
