---
// Pill button with its trailing icon nested in its own circle.
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  icon?: string;
  external?: boolean;
  pdf?: boolean;
}
const { href, variant = 'primary', icon, external = false, pdf = false } = Astro.props;
const trailing = icon ?? (external ? 'arrow-up-right' : 'arrow-right');
---

<a
  class:list={['cta', `cta--${variant}`]}
  href={href}
  {...(external || pdf ? { target: '_blank', rel: 'noopener' } : {})}
>
  <slot />
  {pdf ? (
    <span class="cta__dot cta__dot--pdf" aria-hidden="true">
      PDF
    </span>
  ) : (
    <span class="cta__dot">
      <Icon name={trailing} size={16} />
    </span>
  )}
  {(external || pdf) && (
    <span class="sr-only">{pdf ? ' (PDF, opens in a new tab)' : ' (opens in a new tab)'}</span>
  )}
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    height: 48px;
    padding: 0 0.4rem 0 1.35rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    font: 500 15px/1 var(--font-sans);
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      transform 180ms cubic-bezier(0.32, 0.72, 0, 1),
      background-color 280ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 280ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cta:active {
    transform: scale(0.98);
  }
  .cta--primary {
    background: var(--action);
    color: var(--on-action);
  }
  .cta--primary:hover {
    background: var(--accent-strong);
  }
  .cta--ghost {
    color: var(--ink);
    border-color: var(--muted);
  }
  .cta--ghost:hover {
    border-color: var(--ink);
  }
  .cta__dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--surface-sunken);
    color: var(--ink);
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .cta--primary .cta__dot {
    background: var(--ground);
    color: var(--accent-ink);
  }
  .cta:hover .cta__dot {
    transform: translate(2px, -1px) scale(1.05);
  }
  .cta__dot--pdf {
    width: auto;
    padding: 0 0.65rem;
    border-radius: var(--radius-pill);
    font: 500 13px/1 var(--font-sans);
    color: var(--accent-ink);
  }
</style>
