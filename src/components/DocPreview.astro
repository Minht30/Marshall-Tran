---
// A source document shown whole, like a sheet of paper. Selecting it opens the full PDF inside the page.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { documents, type DocKey } from '../data/docs';

interface Props {
  doc: DocKey;
  /** page: full width of its column. compact: a narrower sheet for side columns. */
  size?: 'page' | 'compact';
  /** Hide the title block when the surrounding layout already names the document. */
  bare?: boolean;
}
const { doc, size = 'page', bare = false } = Astro.props;
const d = documents[doc];
const landscape = d.page.width > d.page.height;
---

<figure class:list={['sheet', `sheet--${size}`, { 'sheet--wide': landscape }]}>
  <button
    type="button"
    class="sheet__paper"
    data-doc-pdf={d.pdf}
    data-doc-caption={`${d.title}. ${d.issuer}, ${d.date}`}
  >
    <Image
      src={d.page}
      alt={`First page of ${d.title}, ${d.issuer}`}
      widths={[360, 560, 900]}
      width={900}
      sizes={size === 'compact' ? '300px' : '(min-width: 1024px) 520px, 100vw'}
    />
    <span class="sheet__open">
      <Icon name="arrows-out-simple" size={16} /> Open PDF
    </span>
  </button>
  {!bare && (
    <figcaption class="sheet__cap">
      <span class="sheet__title">{d.title}</span>
      <span class="sheet__issuer">
        {d.issuer}, {d.date}
      </span>
    </figcaption>
  )}
</figure>

<style>
  .sheet {
    margin: 0;
    display: grid;
    gap: 0.8rem;
    width: 100%;
  }
  .sheet--compact {
    max-width: 300px;
  }
  .sheet--compact.sheet--wide {
    max-width: 380px;
  }
  .sheet__paper {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-xs);
    background: #fff;
    cursor: zoom-in;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgb(10 25 60 / 0.08),
      0 18px 40px -18px rgb(10 25 60 / 0.35);
    transition:
      transform 500ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .sheet__paper :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sheet__paper:hover,
  .sheet__paper:focus-visible {
    transform: translateY(-6px) rotate(-0.6deg);
    box-shadow:
      0 2px 4px rgb(10 25 60 / 0.1),
      0 30px 60px -22px rgb(10 25 60 / 0.45);
  }
  .sheet__paper:active {
    transform: translateY(-2px) scale(0.99);
  }
  .sheet__open {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--action);
    color: var(--on-action);
    font: 600 14px/1 var(--font-sans);
    box-shadow: 0 6px 16px -6px rgb(10 25 60 / 0.5);
    transform: translateY(4px);
    opacity: 0.92;
    transition:
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 280ms;
  }
  .sheet__paper:hover .sheet__open,
  .sheet__paper:focus-visible .sheet__open {
    transform: none;
    opacity: 1;
  }
  .sheet__cap {
    display: grid;
    gap: 0.2rem;
  }
  .sheet__title {
    font-weight: 700;
    font-size: 17px;
  }
  .sheet__issuer {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.45;
  }
</style>
