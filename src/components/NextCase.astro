---
// The end of a case study: pick any of the other case studies, or see every project.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Status from './Status.astro';

interface Props {
  current: string;
}
const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const others = all.filter((w) => w.id !== Astro.props.current);
---

<nav class="pick" aria-labelledby="pick-title">
  <div class="pick__head">
    <h2 class="h3" id="pick-title">
      More case studies
    </h2>
    <a class="pick__all" href="/projects">
      See all projects <Icon name="arrow-right" size={16} />
    </a>
  </div>
  <ul class="pick__list">
    {others.map((w) => (
      <li>
        <a class="pick__card" href={`/work/${w.id}`}>
          <span class="pick__img">
            <Image
              src={w.data.cover}
              alt=""
              widths={[320, 520]}
              width={520}
              sizes="(min-width: 1024px) 360px, 100vw"
            />
          </span>
          <span class="pick__body">
            <span class="pick__ctx">{w.data.context}</span>
            <span class="pick__title">{w.data.title}</span>
            <Status status={w.data.status} />
          </span>
          <span class="pick__dot" aria-hidden="true">
            <Icon name="arrow-up-right" size={18} />
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .pick {
    padding: var(--space-6) 0 var(--space-7);
  }
  .pick__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
  }
  .pick__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .pick__all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .pick__list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .pick__card {
    position: relative;
    display: grid;
    height: 100%;
    border-radius: calc(var(--radius-lg) + 4px);
    padding: 6px;
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 400ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .pick__card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }
  .pick__img {
    display: grid;
    place-items: center;
    height: 200px;
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    background: radial-gradient(closest-side, var(--mark-bg), transparent), var(--surface-sunken);
    overflow: hidden;
  }
  .pick__img :global(img) {
    width: auto;
    max-width: 100%;
    max-height: 168px;
    border-radius: 6px;
    box-shadow: var(--shadow-sm);
  }
  .pick__body {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    padding: var(--space-3) var(--space-3) var(--space-3);
  }
  .pick__ctx {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .pick__title {
    font: 700 24px/1.15 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .pick__dot {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--action);
    color: var(--on-action);
    transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .pick__card:hover .pick__dot {
    transform: translate(3px, -3px);
  }
  @media (max-width: 1023px) {
    .pick__list {
      grid-template-columns: 1fr;
    }
    .pick__img {
      height: 180px;
    }
  }
</style>
